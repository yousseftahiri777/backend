# ── Database ───────────────────────────────────────────────────────────────────
APP_ENV=production
DATABASE_URL=postgres://lamabeauty:replace-with-a-long-random-database-password@lamabeauty_database:5432/lamabeauty?sslmode=disable

# ── MaxMind GeoIP Insights (VPN / proxy / country blocking) ───────────────────
#
# FREE TRIAL ($5 credits ≈ 2,500 IP lookups):
#   1. Turn OFF VPN/proxy before signing up (MaxMind may reject otherwise).
#   2. Request trial: https://www.maxmind.com/en/request-service-trial?service_geoip=1
#   3. Select only "GeoIP web services".
#   4. Suggested form answers:
#        Industry: eCommerce/Retail
#        Intended use: Fraud → Transactions (or Networking → VPN/proxy enforcement)
#        Volume: Less than 1,000
#        Platform: FastAPI backend + Next.js (lamabeauty.shop)
#   5. Check email for Account ID + License Key (usually minutes–24h).
#   6. Paste both values below and restart the backend.
#
# Pricing after trial: GeoIP Insights = $0.002/query. Same IP is cached 1 hour in code.
# GeoLite (free forever) does NOT include VPN/proxy detection — trial Insights is required.
#
# If MAXMIND_* are blank, requests are blocked unless GEO_FAIL_OPEN=true.
# License keys: https://www.maxmind.com/en/accounts/current/license-key
MAXMIND_ACCOUNT_ID=your_maxmind_account_id
MAXMIND_LICENSE_KEY=your_maxmind_license_key
GEO_FAIL_OPEN=false
# Must match the trusted frontend/reverse proxy's server-only value.
BACKEND_PROXY_SECRET=replace-with-a-long-random-value
# Used to derive recoverable idempotent public-order capabilities. Keep server-only.
ORDER_TOKEN_SECRET=replace-with-another-long-random-value

# ── Google Sheets order outbox ────────────────────────────────────────────────
# 1. Paste google_apps_script.js into Apps Script on your Orders sheet
# 2. Deploy → Web app → Anyone → copy the /exec URL here
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
GOOGLE_SHEETS_WEBHOOK_SECRET=replace-with-a-different-long-random-value
SHEET_SYNC_POLL_SECONDS=5
CONTACT_WEBHOOK_URL=

# ── Facebook CAPI ─────────────────────────────────────────────────────────────
FB_ACCESS_TOKEN=
FB_PIXEL_ID=

# ── TikTok Events API ─────────────────────────────────────────────────────────
TIKTOK_ACCESS_TOKEN=
TIKTOK_PIXEL_ID=

# ── Snapchat CAPI ─────────────────────────────────────────────────────────────
SNAP_ACCESS_TOKEN=
SNAP_PIXEL_ID=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated — do NOT use JSON brackets
ALLOWED_ORIGINS=https://lamabeauty.shop,http://localhost:3000

# ── Test / Whitelist ──────────────────────────────────────────────────────────
# Optional single local number for explicit development/test geo bypass.
TEST_PHONE=
ENABLE_DOCS=false

# ── Admin Dashboard ───────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_JWT_SECRET=replace-with-a-long-random-signing-secret
ENABLE_LEGACY_ADMIN_ACCESS_KEY=false
ADMIN_ACCESS_KEY=
