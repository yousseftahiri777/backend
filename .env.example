# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://lamabeauty:lamabeauty@lamabeauty_database:5432/lamabeauty?sslmode=disable

# ── MaxMind GeoIP2 Precision Web Service ──────────────────────────────────────
# Sign up / get credentials at: https://www.maxmind.com/en/accounts/current/license-key
# Requires a GeoIP2 Precision "Insights" subscription for VPN/proxy detection.
# If left blank, geo-checks are DISABLED and all orders are allowed (dev mode).
MAXMIND_ACCOUNT_ID=your_maxmind_account_id
MAXMIND_LICENSE_KEY=your_maxmind_license_key

# ── Google Sheets Webhook ─────────────────────────────────────────────────────
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# ── Facebook CAPI ─────────────────────────────────────────────────────────────
FB_ACCESS_TOKEN=
FB_PIXEL_ID=

# ── TikTok Events API ─────────────────────────────────────────────────────────
TIKTOK_ACCESS_TOKEN=
TIKTOK_PIXEL_ID=

# ── Snapchat CAPI ─────────────────────────────────────────────────────────────
SNAP_ACCESS_TOKEN=
SNAP_PIXEL_ID=

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://lamabeauty.shop,http://localhost:3000

# ── Test / Whitelist ──────────────────────────────────────────────────────────
# Orders placed with this phone bypass MaxMind geo + VPN checks.
# Use it to test order flow in production without needing a KSA IP.
TEST_PHONE=0550000000
